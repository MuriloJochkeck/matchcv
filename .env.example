# Supabase (Project Settings > API Keys)
# Use a publishable key. Never expose a secret/service-role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin used in authentication redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredos somente no servidor (nunca use NEXT_PUBLIC_ para estas variáveis).
SUPABASE_SERVICE_ROLE_KEY=
PROCESSING_WORKER_SECRET=
CRON_SECRET=
# Prazo, em dias, para retenção dos PDFs enviados (padrão: 30; máximo: 3650).
RESUME_RETENTION_DAYS=30
