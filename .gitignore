# Dependencies and package-manager caches
/node_modules/
/node_modules-pnpm-*/
/.npm-cache/
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Tests and reports
/coverage/
/playwright-report/
/test-results/
/blob-report/

# Next.js
/.next/
/out/
/.swc/

# Production output
/build/

# Local service state
/.vercel/
/supabase/.branches/
/supabase/.temp/

# Environment files (keep the documented template)
.env*
!.env.example

# Logs and debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript and tool caches
*.tsbuildinfo
next-env.d.ts
.eslintcache
/.cache/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Local certificates and keys
*.pem
*.key
